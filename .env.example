# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Web app (all three are required; the app refuses every request until they are set)
DEMO_USERNAME=
DEMO_PASSWORD=
FLASK_SECRET_KEY=

# Optional
DATASET=dev            # dev (12 shipments) or extended (60)
RUNS_DB=               # path of the SQLite file; default ./runs.db
PORT=5000
