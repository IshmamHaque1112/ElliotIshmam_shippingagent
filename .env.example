# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Web app (all three are required; the app refuses every request until they are set)
DEMO_USERNAME=
DEMO_PASSWORD=
FLASK_SECRET_KEY=

# Optional
DATASET=dev            # dev (12), extended (60) or edge (9 data-quality cases)
RUNS_DB=               # path of the SQLite file; default ./runs.db
PORT=5000
MODEL_CALLS_ENABLED=true   # false = kill switch: no Claude call from any page or API

# Hosting (see docs/DEPLOY.md)
TRUST_PROXY_HOPS=          # 1 behind one reverse proxy, so client addresses and https are read correctly
COOKIE_SECURE=             # true when the site is served over https
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=180

# Private hold-out runs (leave empty normally; eval.py can also take these as flags)
DATASET_FILE=          # path to a private dataset outside the repo
FAULTS_FILE=           # optional fault schedule for that dataset
EVAL_LABELS_FILE=      # path to its private labels
